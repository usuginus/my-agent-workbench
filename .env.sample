SLACK_BOT_TOKEN=xoxb-hogehoge
SLACK_APP_TOKEN=xapp-hogehoge
SLACK_SIGNING_SECRET=hogehoge

# OPENAI_API_KEY=sk-xxxxxxxx

CODEX_MODEL=gpt-5.2
CODEX_WEB_SEARCH=1
CODEX_REASONING_EFFORT=low
CODEX_REFINE=1
CODEX_REFINE_MAX=4
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_RESEARCH_TIMEOUT_MS=900000
RESEARCH_MAX_CONCURRENT=2

# NEWS_CHANNEL_ID=C12345678
NEWS_CRON=30 17 * * *
# NEWS_EXTRA_INTERESTS=VRChat,制御工学

# 30分ごとに会話を見て、週4〜6回くらい自然に混ざる
# CHATTER_CHANNEL_ID=C12345678
CHATTER_CRON=*/30 * * * *
CHATTER_WEEKLY_TARGET=5
CHATTER_ACTIVE_START_HOUR=9
CHATTER_ACTIVE_END_HOUR=24
CHATTER_LOOKBACK_MIN=90
CHATTER_MIN_MESSAGES=2
CHATTER_COOLDOWN_MIN=360
CHATTER_OPPORTUNITY_RATE=0.35
CHATTER_DEBUG=0

MEMORY_DIR=memory
MEMORY_DISTILL=1

# PLANNER_REPO_DIR=/path/to/repo
# PLANNER_DEBUG=0
# PORT=8080
